<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Criar Pedido - Pedido de Compras</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link rel="stylesheet" href="/css/style.css" />
    <link rel="stylesheet" href="/css/responsive.css" />
    <style>
        /* Custom overrides if necessary, but trying to stick to style.css */
        .sidebar .nav-link {
            color: #475569;
            font-weight: 500;
            padding: 10px 15px;
            border-radius: 8px;
            transition: all 0.3s ease;
            text-decoration: none;
            display: flex;
            align-items: center;
        }
        .sidebar .nav-link:hover {
            color: #ea580c;
            background: #fff7ed;
        }
        .sidebar .nav-link.active {
            color: #ea580c;
            background: #fff7ed;
            font-weight: 600;
        }
        .sidebar .nav-link i {
            margin-right: 10px;
            font-size: 1.1rem;
        }
    </style>
</head>
<body>
    <div class="layout">
        <!-- Sidebar Partial -->
        <%- include('../partials/sidebar', { module: 'pedidos', activePage: 'criar' }) %>

        <!-- Main Content -->
        <div class="content">
            <div class="form-container">
                <h1 style="font-size: 1.5rem; color: #1e293b; margin-bottom: 0.5rem; text-align: center;">Criar Novo Pedido</h1>
                <p style="color: #64748b; text-align: center; margin-bottom: 2rem;">Preencha os dados para gerar um novo pedido de compras</p>

                <form>
                    <div class="mb-3">
                        <label for="dtInit">Data Inicial</label>
                        <input type="date" id="dtInit" required>
                    </div>

                    <div class="mb-3">
                        <label for="dtEnd">Data Final</label>
                        <input type="date" id="dtEnd" required>
                    </div>

                    <div class="mb-3 position-relative">
                        <label for="marca">Marca</label>
                        <input type="text" id="marca" placeholder="Digite para buscar" autocomplete="off" onkeyup="filtrarMarcas()">
                        <div id="marcaLista" class="dropdown-menu w-100" style="display: none; position: absolute; z-index: 1000; max-height: 200px; overflow-y: auto;"></div>
                    </div>

                    <div class="mb-3">
                        <label for="gpEmp">Grupo Empresa</label>
                        <select id="gpEmp" class="form-select" style="width: 100%; padding: 10px 12px; border: 1px solid #cbd5e1; border-radius: 8px; margin-bottom: 15px;" required>
                            <option value="">Selecione o Grupo da Empresa</option>
                            <option value="1">Exclusiva</option>
                            <option value="2">Prime</option>
                            <option value="3">Site</option>
                        </select>
                    </div>

                    <button type="button" onclick="salvaPedido()" style="width: 100%;">
                        <i class="bi bi-plus-circle me-2"></i>
                        Criar Pedido
                    </button>
                </form>
            </div>
        </div>
    </div>

    <form id="logoutForm" action="/logout" method="POST" style="display: none;"></form>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="/js/pedidos/scriptPedidos.js"></script>
    <script>
        // Logout functionality with SweetAlert2
        document.getElementById('logoutBtn').addEventListener('click', function(e) {
            e.preventDefault();
            Swal.fire({
                title: 'Tem certeza?',
                text: "Você será desconectado do sistema.",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#ea580c',
                cancelButtonColor: '#64748b',
                confirmButtonText: 'Sim, sair!',
                cancelButtonText: 'Cancelar'
            }).then((result) => {
                if (result.isConfirmed) {
                    document.getElementById('logoutForm').submit();
                }
            });
        });

        // Override salvaPedido to show confirmation dialog after success
        const originalSalvaPedido = window.salvaPedido;
        window.salvaPedido = async function() {
            try {
                const result = await originalSalvaPedido();
                
                // Show success dialog with options
                Swal.fire({
                    title: 'Pedido criado com sucesso!',
                    text: "O que deseja fazer agora?",
                    icon: 'success',
                    showCancelButton: true,
                    confirmButtonColor: '#28a745',
                    cancelButtonColor: '#dc3545',
                    confirmButtonText: 'Ir para Listas De Pedidos',
                    cancelButtonText: 'Continuar Aqui'
                }).then((result) => {
                    if (result.isConfirmed) {
                        // Redirect to fazer pedidos
                        window.location.href = '/listaPedidos';
                    } else {
                        // Clear form to create another pedido
                        document.getElementById('marca').value = '';
                        document.getElementById('dtInit').value = '';
                        document.getElementById('dtEnd').value = '';
                        document.getElementById('gpEmp').value = '';
                    }
                });
            } catch (error) {
                Swal.fire({
                    title: 'Erro!',
                    text: error.message || 'Erro ao criar pedido',
                    icon: 'error',
                    confirmButtonText: 'OK'
                });
            }
        };
    </script>
</body>
</html>
