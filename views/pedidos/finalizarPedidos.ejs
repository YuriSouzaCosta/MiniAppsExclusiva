<!DOCTYPE html>
<html lang="pt-br">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Finalizar Pedidos - Pedido de Compras</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <link rel="stylesheet" href="/css/style.css" />
    <link rel="stylesheet" href="/css/responsive.css" />
    <style>
      body {
        font-family: 'Poppins', sans-serif;
      }
      .sidebar .nav-link {
          color: #475569;
          font-weight: 500;
          padding: 10px 15px;
          border-radius: 8px;
          transition: all 0.3s ease;
          text-decoration: none;
          display: flex;
          align-items: center;
      }
      .sidebar .nav-link:hover {
          color: #ea580c;
          background: #fff7ed;
      }
      .sidebar .nav-link.active {
          color: #ea580c;
          background: #fff7ed;
          font-weight: 600;
      }
      .sidebar .nav-link i {
          margin-right: 10px;
          font-size: 1.1rem;
      }

      .pedido-card {
          background: white;
          border-radius: 16px;
          padding: 1.75rem;
          margin-bottom: 1.5rem;
          box-shadow: 0 1px 3px 0 rgb(0 0 0 / 0.1);
          border: 1px solid #e2e8f0;
          transition: all 0.3s ease;
          animation: fadeInUp 0.5s ease;
      }

      .pedido-card:hover {
          transform: translateY(-2px);
          box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1);
      }

      @keyframes fadeInUp {
          from { opacity: 0; transform: translateY(20px); }
          to { opacity: 1; transform: translateY(0); }
      }

      .card-header-custom {
          display: flex;
          justify-content: space-between;
          align-items: center;
          margin-bottom: 1.5rem;
          padding-bottom: 1rem;
          border-bottom: 2px solid #f8fafc;
      }

      .pedido-numero {
          font-size: 1.25rem;
          font-weight: 700;
          color: #1e293b;
      }

      .badge-feito {
          background: #fff7ed;
          color: #ea580c;
          padding: 0.5rem 1rem;
          border-radius: 20px;
          font-weight: 600;
          font-size: 0.75rem;
          text-transform: uppercase;
          border: 1px solid #ffedd5;
      }

      .info-grid {
          display: grid;
          grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
          gap: 1.25rem;
          margin-bottom: 1.5rem;
      }

      .info-item {
          display: flex;
          flex-direction: column;
      }

      .info-label {
          font-size: 0.7rem;
          font-weight: 600;
          color: #64748b;
          text-transform: uppercase;
          letter-spacing: 0.05em;
          margin-bottom: 0.25rem;
      }

      .info-value {
          font-size: 0.9rem;
          font-weight: 600;
          color: #334155;
      }

      .form-section {
          background: #f8fafc;
          border-radius: 12px;
          padding: 1.25rem;
          margin-bottom: 1.5rem;
          border: 1px solid #e2e8f0;
      }

      .form-section-title {
          font-size: 0.75rem;
          font-weight: 700;
          color: #ea580c;
          text-transform: uppercase;
          letter-spacing: 0.05em;
          margin-bottom: 1rem;
      }

      .input-custom {
          width: 100%;
          padding: 0.6rem 1rem;
          border: 1px solid #cbd5e1;
          border-radius: 8px;
          font-size: 0.9rem;
          transition: all 0.2s;
          background: white;
      }

      .input-custom:focus {
          outline: none;
          border-color: #ea580c;
          box-shadow: 0 0 0 3px rgba(234, 88, 12, 0.1);
      }

      .actions-section {
          display: flex;
          gap: 0.75rem;
          padding-top: 1rem;
          border-top: 1px solid #f1f5f9;
      }

      .btn-action {
          flex: 1;
          padding: 0.6rem 1.25rem;
          border-radius: 8px;
          font-weight: 600;
          font-size: 0.9rem;
          border: none;
          transition: all 0.2s;
          display: flex;
          align-items: center;
          justify-content: center;
          gap: 0.5rem;
      }

      .btn-success-custom {
          background-color: #10b981;
          color: white;
      }
      .btn-success-custom:hover {
          background-color: #059669;
      }

      .btn-primary-custom {
          background-color: #ea580c;
          color: white;
      }
      .btn-primary-custom:hover {
          background-color: #c2410c;
      }

      .btn-danger-custom {
          background-color: #ef4444;
          color: white;
      }
      .btn-danger-custom:hover {
          background-color: #dc2626;
      }

      .btn-dark-custom {
          background-color: #334155;
          color: white;
      }
      .btn-dark-custom:hover {
          background-color: #1e293b;
      }

      .empty-state {
          text-align: center;
          padding: 4rem 2rem;
          background: white;
          border-radius: 12px;
          border: 1px solid #e2e8f0;
      }

      .empty-state i {
          font-size: 3rem;
          color: #cbd5e1;
          margin-bottom: 1rem;
      }
    </style>
  </head>

  <body>
    <div class="layout">
    <!-- Sidebar -->
   <%- include('../partials/sidebar', { module: 'pedidos', activePage: 'finalizar' }) %>

    <!-- Main Content -->
    <div class="content">
      
        <!-- Page Header -->
        <div class="d-flex justify-content-between align-items-center mb-4">
          <div>
              <h1 style="font-size: 1.5rem; color: #1e293b; margin-bottom: 0;">Finalizar Pedidos</h1>
              <p style="color: #64748b; margin-bottom: 0;">Complete os pedidos com fornecedor e forma de pagamento</p>
          </div>
        </div>

        <!-- Search Bar -->
        <div class="row g-3 mb-4">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0">
                        <i class="bi bi-search text-muted"></i>
                    </span>
                    <input 
                        type="text" 
                        id="searchSupplier" 
                        class="form-control border-start-0 ps-0" 
                        placeholder="Buscar por fornecedor ou marca..."
                        autocomplete="off"
                    >
                    <button class="btn btn-outline-secondary" type="button" id="clearSearch">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
            </div>
            
            <div class="col-md-3">
                <select id="storeFilter" class="form-select">
                    <option value="">Todas as Lojas</option>
                    <option value="PRIME">PRIME</option>
                    <option value="EXCLUSIVA">EXCLUSIVA</option>
                </select>
            </div>
            
            <div class="col-md-4">
                <button type="button" id="btnGenerateReport" class="btn btn-primary-custom w-100">
                    <i class="bi bi-file-earmark-text me-2"></i> Gerar Relatório
                </button>
            </div>
        </div>

        <!-- Pedidos Container -->
        <div id="pedidosContainer"></div>

        <!-- Empty State -->
        <div id="emptyState" class="empty-state" style="display: none;">
            <i class="bi bi-inbox"></i>
            <h3>Nenhum pedido pronto para finalizar</h3>
            <p>Complete os pedidos pendentes para finalizá-los aqui.</p>
        </div>
    </div>

    <form id="logoutForm" action="/logout" method="POST" style="display: none;"></form>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.6.0/jspdf.plugin.autotable.min.js"></script>
    <script src="/js/pedidos/scriptPedidos.js"></script>
    <script>
        // Logout functionality with SweetAlert2
        document.getElementById('logoutBtn').addEventListener('click', function(e) {
            e.preventDefault();
            Swal.fire({
                title: 'Tem certeza?',
                text: "Você será desconectado do sistema.",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#ea580c',
                cancelButtonColor: '#64748b',
                confirmButtonText: 'Sim, sair!',
                cancelButtonText: 'Cancelar'
            }).then((result) => {
                if (result.isConfirmed) {
                    document.getElementById('logoutForm').submit();
                }
            });
        });
    </script>
  </body>
</html>
