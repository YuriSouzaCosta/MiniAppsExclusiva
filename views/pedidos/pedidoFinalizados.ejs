<!DOCTYPE html>
<html lang="pt-br">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Pedidos Finalizados - Pedido de Compras</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <link rel="stylesheet" href="/css/style.css" />
    <link rel="stylesheet" href="/css/responsive.css" />
    <style>
      body {
        font-family: 'Poppins', sans-serif;
      }
      .sidebar .nav-link {
          color: #475569;
          font-weight: 500;
          padding: 10px 15px;
          border-radius: 8px;
          transition: all 0.3s ease;
          text-decoration: none;
          display: flex;
          align-items: center;
      }
      .sidebar .nav-link:hover {
          color: #ea580c;
          background: #fff7ed;
      }
      .sidebar .nav-link.active {
          color: #ea580c;
          background: #fff7ed;
          font-weight: 600;
      }
      .sidebar .nav-link i {
          margin-right: 10px;
          font-size: 1.1rem;
      }

      .pedido-card {
          background: white;
          border-radius: 16px;
          padding: 1.75rem;
          margin-bottom: 1.5rem;
          box-shadow: 0 1px 3px 0 rgb(0 0 0 / 0.1);
          border: 1px solid #e2e8f0;
          transition: all 0.3s ease;
          animation: fadeInUp 0.5s ease;
      }

      .pedido-card:hover {
          transform: translateY(-2px);
          box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1);
      }

      @keyframes fadeInUp {
          from { opacity: 0; transform: translateY(20px); }
          to { opacity: 1; transform: translateY(0); }
      }

      .card-header-custom {
          display: flex;
          justify-content: space-between;
          align-items: center;
          margin-bottom: 1.5rem;
          padding-bottom: 1rem;
          border-bottom: 2px solid #f8fafc;
      }

      .pedido-numero {
          font-size: 1.25rem;
          font-weight: 700;
          color: #1e293b;
      }

      .badge-finalizado {
          background: #dcfce7;
          color: #166534;
          padding: 0.5rem 1rem;
          border-radius: 20px;
          font-weight: 600;
          font-size: 0.75rem;
          text-transform: uppercase;
          border: 1px solid #bbf7d0;
      }

      .info-grid {
          display: grid;
          grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
          gap: 1.25rem;
          margin-bottom: 1.5rem;
      }

      .info-item {
          display: flex;
          flex-direction: column;
      }

      .info-label {
          font-size: 0.7rem;
          font-weight: 600;
          color: #64748b;
          text-transform: uppercase;
          letter-spacing: 0.05em;
          margin-bottom: 0.25rem;
      }

      .info-value {
          font-size: 0.9rem;
          font-weight: 600;
          color: #334155;
      }

      .valor-total {
          background: #fff7ed;
          color: #ea580c;
          padding: 1rem;
          border-radius: 12px;
          text-align: center;
          margin-bottom: 1.5rem;
          border: 1px solid #ffedd5;
      }

      .valor-total-label {
          font-size: 0.75rem;
          font-weight: 600;
          text-transform: uppercase;
          margin-bottom: 0.25rem;
      }

      .valor-total-value {
          font-size: 1.5rem;
          font-weight: 700;
      }

      .actions-section {
          display: flex;
          gap: 0.75rem;
          padding-top: 1rem;
          border-top: 1px solid #f1f5f9;
      }

      .btn-action {
          flex: 1;
          padding: 0.6rem 1.25rem;
          border-radius: 8px;
          font-weight: 600;
          font-size: 0.9rem;
          border: none;
          transition: all 0.2s;
          display: flex;
          align-items: center;
          justify-content: center;
          gap: 0.5rem;
      }

      .btn-primary-custom {
          background-color: #ea580c;
          color: white;
      }
      .btn-primary-custom:hover {
          background-color: #c2410c;
      }

      .btn-danger-custom {
          background-color: #ef4444;
          color: white;
      }
      .btn-danger-custom:hover {
          background-color: #dc2626;
      }

      .empty-state {
          text-align: center;
          padding: 4rem 2rem;
          background: white;
          border-radius: 12px;
          border: 1px solid #e2e8f0;
      }

      .empty-state i {
          font-size: 3rem;
          color: #cbd5e1;
          margin-bottom: 1rem;
      }
    </style>
  </head>

  <body>
    <div class="layout">
    <!-- Sidebar -->
    <%- include('../partials/sidebar', { module: 'pedidos', activePage: 'finalizados' }) %>

    <!-- Main Content -->
    <div class="content">
      <div class="container-fluid">
        <!-- Page Header -->
        <div class="d-flex justify-content-between align-items-center mb-4">
          <div>
              <h1 style="font-size: 1.5rem; color: #1e293b; margin-bottom: 0;">Pedidos Finalizados</h1>
              <p style="color: #64748b; margin-bottom: 0;">Visualize o histórico de pedidos concluídos</p>
          </div>
        </div>

        <!-- Pedidos Container -->
        <div id="pedidosTableBody"></div>

        <!-- Empty State -->
        <div id="emptyState" class="empty-state" style="display: none;">
            <i class="bi bi-inbox"></i>
            <h3>Nenhum pedido finalizado</h3>
            <p>Os pedidos finalizados aparecerão aqui.</p>
        </div>
      </div>
    </div>

    <form id="logoutForm" action="/logout" method="POST" style="display: none;"></form>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.6.0/jspdf.plugin.autotable.min.js"></script>
    <script src="/js/pedidos/scriptPedidos.js"></script>
    <script>
        // Override the carregaPedidosFeitosFinalizados function to use the new card layout
        async function carregaPedidosFeitosFinalizados() {
            const container = document.getElementById('pedidosTableBody');
            const emptyState = document.getElementById('emptyState');

            try {
                const apiUrl = `${apiBase}/consultarPedidosCompleto`;
                const response = await fetch(apiUrl);

                if (!response.ok) {
                    throw new Error("Erro ao carregar pedidos");
                }

                const pedidosCompras = await response.json();
                console.log('Pedidos finalizados:', pedidosCompras);

                if (pedidosCompras.length === 0) {
                    emptyState.style.display = 'block';
                    return;
                }

                container.innerHTML = '';

                pedidosCompras.forEach((pedido, index) => {
                    const card = document.createElement('div');
                    card.className = 'pedido-card';
                    card.style.animationDelay = `${index * 0.1}s`;

                    const empresa = pedido.EMPRESA == '1,3' ? "Exclusiva" : "Prime";

                    card.innerHTML = `
                        <div class="card-header-custom">
                            <div class="pedido-numero">
                                <i class="bi bi-receipt me-2"></i>Pedido #${pedido.NUMERO_PEDIDO}
                            </div>
                            <span class="badge-finalizado">
                                ${pedido.ANDAMENTO}
                            </span>
                        </div>
                        <div class="info-grid">
                            <div class="info-item">
                                <span class="info-label">Nota Fiscal</span>
                                <span class="info-value">${pedido.NUNOTA || 'N/A'}</span>
                            </div>
                            <div class="info-item">
                                <span class="info-label">Fornecedor</span>
                                <span class="info-value">${pedido.PARCEIRO}</span>
                            </div>
                            <div class="info-item">
                                <span class="info-label">Marca</span>
                                <span class="info-value">${pedido.MARCA}</span>
                            </div>
                            <div class="info-item">
                                <span class="info-label">Data do Pedido</span>
                                <span class="info-value">${pedido.DATA_PEDIDO ? new Date(pedido.DATA_PEDIDO).toLocaleDateString('pt-BR') : ''}</span>
                            </div>
                            <div class="info-item">
                                <span class="info-label">Data Faturamento</span>
                                <span class="info-value">${pedido.DATAFATURAMENTO ? new Date(pedido.DATAFATURAMENTO).toLocaleDateString('pt-BR') : ''}</span>
                            </div>
                            <div class="info-item">
                                <span class="info-label">Data Entrega</span>
                                <span class="info-value">${pedido.DATAENTREGA ? new Date(pedido.DATAENTREGA).toLocaleDateString('pt-BR') : ''}</span>
                            </div>
                            <div class="info-item">
                                <span class="info-label">Empresa</span>
                                <span class="info-value">${empresa}</span>
                            </div>
                            <div class="info-item">
                                <span class="info-label">Forma de Pagamento</span>
                                <span class="info-value">${pedido.FORMA_PAGTO || ''}</span>
                            </div>
                        </div>
                        <div class="valor-total">
                            <div class="valor-total-label">Valor Total</div>
                            <div class="valor-total-value">R$ ${parseFloat(pedido.VLRTOTAL || 0).toFixed(2)}</div>
                        </div>
                        <div class="actions-section">
                            <button type="button" class="btn btn-action btn-primary-custom" onclick="carregarDadosPedido(${pedido.NUMERO_PEDIDO})">
                                <i class="bi bi-eye"></i>
                                Visualizar
                            </button>
                            <button type="button" class="btn btn-action text-white" style="background-color:#eab308; border:none;" onclick="reprocessarPedido(${pedido.NUMERO_PEDIDO})">
                                <i class="bi bi-arrow-repeat"></i>
                                Reprocessar
                            </button>
                            <button type="button" class="btn btn-action btn-danger-custom" onclick="apagarPedido(${pedido.NUMERO_PEDIDO})">
                                <i class="bi bi-trash"></i>
                                Excluir
                            </button>
                        </div>
                    `;

                    container.appendChild(card);
                });

            } catch (error) {
                console.error("Erro ao carregar Pedidos:", error.message);
                emptyState.style.display = 'block';
                emptyState.innerHTML = `
                    <i class="bi bi-exclamation-triangle text-danger"></i>
                    <h3>Erro ao carregar pedidos</h3>
                    <p>${error.message}</p>
                `;
            }
        }

        // Load pedidos when page loads
        document.addEventListener('DOMContentLoaded', function() {
            carregaPedidosFeitosFinalizados();
        });

        // Logout functionality with SweetAlert2
        document.getElementById('logoutBtn').addEventListener('click', function(e) {
            e.preventDefault();
            Swal.fire({
                title: 'Tem certeza?',
                text: "Você será desconectado do sistema.",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#ea580c',
                cancelButtonColor: '#64748b',
                confirmButtonText: 'Sim, sair!',
                cancelButtonText: 'Cancelar'
            }).then((result) => {
                if (result.isConfirmed) {
                    document.getElementById('logoutForm').submit();
                }
            });
        });

        // Add the reprocess button functionality
        async function reprocessarPedido(id) {
            Swal.fire({
                title: 'Reprocessar Pedido?',
                text: "Uma nova cópia será gerada e enviada para o Sankhya.",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#eab308',
                cancelButtonColor: '#64748b',
                confirmButtonText: 'Sim, reprocessar!',
                cancelButtonText: 'Cancelar'
            }).then(async (result) => {
                if (result.isConfirmed) {
                    Swal.fire({
                        title: 'Reprocessando...',
                        html: 'Clonando o pedido e gerando envio no Sankhya',
                        allowOutsideClick: false,
                        didOpen: () => { Swal.showLoading(); }
                    });

                    try {
                        // Assuming apiBase is a global set somewhere else, keeping it relative is safe
                        const response = await fetch(`/reprocessar-pedido/${id}`, { method: 'POST' });
                        const data = await response.json();
                        
                        if (response.ok && data.success) {
                            Swal.fire('Sucesso!', 'Pedido reprocessado. (Novo Nro Único: ' + (data.nunotaGerado || 'Aberto') + ')', 'success');
                            carregaPedidosFeitosFinalizados(); // Recarrega a tabela visualizada no DOM
                        } else {
                            const errorMsg = data.error ? data.error + (data.details ? ' - Detalhes: ' + data.details : '') : (data.details || 'Erro desconhecido ao reprocessar');
                            throw new Error(errorMsg);
                        }
                    } catch (error) {
                        Swal.fire('Erro!', error.message, 'error');
                    }
                }
            });
        }

    </script>
  </body>
</html>
