<!DOCTYPE html>
<html lang="pt-BR"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Categorias do Painel</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet"><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"><style>body{background:#f8fafc;color:#1e293b}.page-header{background:#fff;border-bottom:1px solid #e2e8f0}.icon-preview{width:38px;height:38px;display:grid;place-items:center;border-radius:10px;background:#fff4ec;color:#ea580c}.card{border:0}.table td,.table th{vertical-align:middle}.form-control-sm,.form-select-sm{min-width:90px}</style></head>
<body><header class="page-header py-3 mb-4"><div class="container d-flex justify-content-between align-items-center gap-3"><div><h1 class="h3 mb-1"><i class="fas fa-folder-tree text-primary me-2"></i>Categorias do Painel</h1><p class="text-muted mb-0">Crie categorias e organize os acessos da Central.</p></div><a href="/" class="btn btn-outline-secondary"><i class="fas fa-arrow-left me-1"></i>Voltar</a></div></header>
<main class="container pb-5">
<% if (!installed) { %><div class="alert alert-warning"><strong>Instalação pendente:</strong> execute <code>menu_categorias_ddl.sql</code> no Oracle. A Central continua usando a organização padrão até lá.</div><% } %>
<% if (success) { %><div class="alert alert-success"><%= success %></div><% } %><% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>
<form id="menu-batch" method="POST" action="/gerenciamento-categorias/salvar-todos"></form>
<section class="card shadow-sm mb-4"><div class="card-body"><h2 class="h5 mb-3">Nova categoria</h2><form method="POST" action="/gerenciamento-categorias" class="row g-3"><div class="col-md-4"><label class="form-label">Nome</label><input class="form-control" name="name" maxlength="120" required placeholder="Ex.: Recursos Humanos"></div><div class="col-md-3"><label class="form-label">Ícone Font Awesome</label><input class="form-control" name="icon" value="fa-folder" pattern="fa-[a-z0-9-]+"></div><div class="col-md-2"><label class="form-label">Ordem</label><input class="form-control" name="order" type="number" value="90"></div><div class="col-md-3 d-flex align-items-end"><button class="btn btn-primary w-100" <%= installed ? '' : 'disabled' %>><i class="fas fa-plus me-1"></i>Criar categoria</button></div></form></div></section>
<section class="card shadow-sm mb-4"><div class="card-body p-0"><div class="p-3 border-bottom"><h2 class="h5 mb-0">Categorias existentes</h2></div><div class="table-responsive"><table class="table table-hover mb-0"><thead class="table-light"><tr><th>Categoria</th><th>Ícone</th><th>Ordem</th><th>Status</th><th>Acessos</th><th class="text-end">Ações</th></tr></thead><tbody>
<% categories.forEach(category => { %><tr><td><input class="form-control form-control-sm" name="categories[<%= category.key %>][name]" value="<%= category.name %>" form="menu-batch" required></td><td><div class="d-flex align-items-center gap-2"><span class="icon-preview"><i class="fas <%= category.icon %>"></i></span><input class="form-control form-control-sm" style="max-width:170px" name="categories[<%= category.key %>][icon]" value="<%= category.icon %>" form="menu-batch"></div></td><td><input class="form-control form-control-sm" style="max-width:90px" type="number" name="categories[<%= category.key %>][order]" value="<%= category.order %>" form="menu-batch"></td><td><select class="form-select form-select-sm" name="categories[<%= category.key %>][active]" form="menu-batch"><option value="S" <%= category.active ? 'selected' : '' %>>Ativa</option><option value="N" <%= !category.active ? 'selected' : '' %>>Oculta</option></select></td><td><span class="badge text-bg-light"><%= category.apps.length %></span></td><td class="text-end"><form class="d-inline delete-form" method="POST" action="/gerenciamento-categorias/<%= category.key %>/excluir"><button class="btn btn-outline-danger btn-sm" <%= installed ? '' : 'disabled' %>><i class="fas fa-trash"></i></button></form></td></tr><% }) %>
</tbody></table></div></div></section>
<section class="card shadow-sm"><div class="card-body p-0"><div class="p-3 border-bottom"><h2 class="h5 mb-1">Organização dos acessos</h2><p class="text-muted small mb-0">Escolha a categoria e se o card deve aparecer na Central. Ocultar não apaga nem bloqueia a página.</p></div><div class="table-responsive"><table class="table table-hover mb-0"><thead class="table-light"><tr><th>Acesso</th><th>Categoria</th><th>Ordem</th><th>Exibição</th><th></th></tr></thead><tbody>
<% categories.forEach(category => category.apps.forEach(app => { %><tr class="<%= app.active ? '' : 'table-secondary' %>"><td><strong><%= app.title %></strong><br><small class="text-muted"><%= app.href %></small></td><td><select class="form-select form-select-sm" name="apps[<%= app.key %>][category]" form="menu-batch"><% categories.forEach(option => { %><option value="<%= option.key %>" <%= option.key === category.key ? 'selected' : '' %>><%= option.name %></option><% }) %></select></td><td><input class="form-control form-control-sm" style="max-width:90px" type="number" name="apps[<%= app.key %>][order]" value="<%= app.order %>" form="menu-batch"></td><td><select class="form-select form-select-sm" name="apps[<%= app.key %>][active]" form="menu-batch"><option value="S" <%= app.active ? 'selected' : '' %>>Visível</option><option value="N" <%= !app.active ? 'selected' : '' %>>Oculto</option></select></td><td></td></tr><% })) %>
</tbody></table></div><div class="p-3 border-top text-end"><button class="btn btn-primary" type="submit" form="menu-batch" <%= installed ? '' : 'disabled' %>><i class="fas fa-floppy-disk me-1"></i>Salvar todas as alterações</button></div></div></section></main>
<script>document.querySelectorAll('.delete-form').forEach(form=>form.addEventListener('submit',event=>{if(!confirm('Excluir esta categoria?'))event.preventDefault()}));</script></body></html>
