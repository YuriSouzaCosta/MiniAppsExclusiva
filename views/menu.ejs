<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <!-- Bootstrap CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-9ndCyUaIbzAi2FUVXJi0CjmCapSmO7SnpJef0486qhLnuZ2cdeRhO02iuK6FUUVM" crossorigin="anonymous" />
  <!-- FontAwesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <!-- Responsive CSS -->
  <link rel="stylesheet" href="/css/responsive.css">
  
  <style>
    :root {
      --primary-color: #ea580c; /* Orange-600 */
      --primary-hover: #c2410c; /* Orange-700 */
      --bg-color: #f8fafc; /* Slate-50 */
      --card-bg: #ffffff;
      --text-primary: #1e293b; /* Slate-800 */
      --text-secondary: #64748b; /* Slate-500 */
      --card-hover-transform: translateY(-5px);
      --card-transition: all 0.3s ease;
    }
    
    body { 
      background-color: var(--bg-color);
      min-height: 100vh;
      font-family: 'Inter', 'Segoe UI', sans-serif;
      color: var(--text-primary);
    }

    .dashboard-header {
      background: #ffffff;
      border-bottom: 1px solid #e2e8f0;
      padding: 2rem 0;
      margin-bottom: 3rem;
      box-shadow: 0 1px 3px 0 rgb(0 0 0 / 0.1);
    }

    .app-card {
      border: 1px solid #e2e8f0;
      border-radius: 12px;
      background: var(--card-bg);
      transition: var(--card-transition);
      height: 100%;
      text-decoration: none;
      color: var(--text-primary);
      overflow: hidden;
      box-shadow: 0 1px 2px 0 rgb(0 0 0 / 0.05);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 2.5rem 1.5rem;
      cursor: pointer;
    }

    .app-card:hover {
      transform: var(--card-hover-transform);
      box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1);
      border-color: var(--primary-color);
      color: var(--primary-color);
    }

    .app-icon {
      font-size: 2.5rem;
      margin-bottom: 1.25rem;
      color: var(--text-secondary);
      transition: var(--card-transition);
    }

    .app-card:hover .app-icon {
      transform: scale(1.1);
      color: var(--primary-color);
    }

    .app-title {
      font-weight: 600;
      font-size: 1rem;
      text-align: center;
      margin: 0;
    }

    .logout-btn {
      transition: all 0.3s ease;
      color: var(--text-secondary);
      border-color: #e2e8f0;
    }
    
    .logout-btn:hover {
      transform: scale(1.05);
      background-color: #fee2e2;
      color: #ef4444;
      border-color: #fee2e2;
    }

    .menu-container {
      max-width: 1200px !important;
    }
    
    .search-input-group {
        box-shadow: 0 1px 2px 0 rgb(0 0 0 / 0.05);
        border-radius: 0.5rem;
        overflow: hidden;
        border: 1px solid #e2e8f0;
    }
    
    .search-input-group:focus-within {
        border-color: var(--primary-color);
        box-shadow: 0 0 0 3px rgba(234, 88, 12, 0.1);
    }
  </style>
  <title>Central de Links</title>
</head>

<body>
  <!-- Header Section -->
  <header class="dashboard-header">
    <div class="container menu-container">
      <div class="row align-items-center">
        <div class="col-md-8 text-center text-md-start">
          <h1 class="mb-0 fw-bold" style="color: var(--text-primary); display: flex; align-items: center;">
            <img src="/images/logo.png" alt="Logo" style="height: 40px; margin-right: 15px;">
            Central de Acessos
          </h1>
          <p class="mb-0 mt-2 fs-5" style="color: var(--text-secondary);">
            Bem-vindo, <span class="fw-bold" style="color: var(--primary-color);"><%= user.username.charAt(0).toUpperCase() + user.username.slice(1).toLowerCase() %></span>
          </p>
        </div>
        <div class="col-md-4 text-center text-md-end mt-3 mt-md-0">
          <button id="logoutBtn" class="btn btn-lg logout-btn px-4">
            <i class="fas fa-sign-out-alt me-2"></i>Sair
          </button>
          <form id="logoutForm" action="/logout" method="POST" style="display: none;"></form>
        </div>
      </div>
      
      <!-- Search Bar -->
      <div class="row justify-content-center mt-4">
        <div class="col-md-6">
          <div class="input-group input-group-lg search-input-group">
            <span class="input-group-text bg-white border-0 text-muted">
              <i class="fas fa-search"></i>
            </span>
            <input type="text" id="searchInput" class="form-control border-0" placeholder="Buscar aplicativo..." aria-label="Buscar aplicativo">
          </div>
        </div>
      </div>
    </div>
  </header>

  <!-- Main Content -->
  <div class="container pb-5 menu-container">
    <div class="row g-4 justify-content-center" id="appsContainer">
      
      <!-- Controle dos Cartões -->
       <% if (user.role === 'ADMIN') { %>
      <div class="col-6 col-md-4 col-lg-3 app-item">
        <a href="/controle-cartao" class="app-card">
          <i class="fas fa-credit-card app-icon"></i>
          <h3 class="app-title">Controle de Cartões</h3>
        </a>
      </div>
      <% } %>


      <!-- Central de Requisições (todos os perfis) -->
      <div class="col-6 col-md-4 col-lg-3 app-item">
        <a href="/requisicoes" class="app-card">
          <i class="fas fa-clipboard-list app-icon"></i>
          <h3 class="app-title">Requisições entre Lojas</h3>
        </a>
      </div>

      <!-- Transferências (ADMIN) -->
      <% if (user.role === 'ADMIN') { %>
        <div class="col-6 col-md-4 col-lg-3 app-item">
          <a href="/transferencias" class="app-card">
            <i class="fas fa-exchange-alt app-icon"></i>
            <h3 class="app-title">Transferências</h3>
          </a>
        </div>
      <% } %>

      <!-- Análise de Transferências (ADMIN) -->
      <% if (user.role === 'ADMIN') { %>
        <div class="col-6 col-md-4 col-lg-3 app-item">
          <a href="/analise-transferencias" class="app-card">
            <i class="fas fa-chart-line app-icon"></i>
            <h3 class="app-title">Análise de Transferências</h3>
          </a>
        </div>
      <% } %>

      <!-- Calculadora Custo -->
      <% if (user.role === 'ADMIN') { %>
      <div class="col-6 col-md-4 col-lg-3 app-item">
        <a href="/calculadora-custo" class="app-card">
          <i class="fas fa-calculator app-icon"></i>
          <h3 class="app-title">Calculadora Custo</h3>
        </a>
      </div>
      <% } %>

      <!-- Produtos Avariados -->
      <% if (user.role === 'ADMIN') { %>
      <div class="col-6 col-md-4 col-lg-3 app-item">
        <a href="http://exclusiva.intranet/pendenciaFornecedor" class="app-card">
          <i class="fas fa-box-open app-icon"></i>
          <h3 class="app-title">Produtos Avariados</h3>
        </a>
      </div>
      <% } %>

      <!-- Consulta de Produtos (GERENTE/ADMIN) -->
      <% if (user.role === 'ADMIN') { %>
        <div class="col-6 col-md-4 col-lg-3 app-item">
          <a href="/consulta-produtos" class="app-card">
            <i class="fas fa-tags app-icon"></i>
            <h3 class="app-title">Consulta de Produtos C/ Custo</h3>
          </a>
        </div>
      <% } %>

      <!-- Consulta de Produtos Vendedor -->
      <div class="col-6 col-md-4 col-lg-3 app-item">
        <a href="/consulta-produtos/vendedor" class="app-card">
          <i class="fas fa-search-dollar app-icon"></i>
          <h3 class="app-title">Consulta de Produtos</h3>
        </a>
      </div>


      <!-- Coletor (ADMIN) -->
      
        <div class="col-6 col-md-4 col-lg-3 app-item">
          <a href="/coletor" class="app-card">
            <i class="fas fa-barcode app-icon"></i>
            <h3 class="app-title">Coletor</h3>
          </a>
        </div>
          
        <!-- Pedido de Compra (ADMIN) -->
         <% if (user.role === 'ADMIN' || user.role === 'ASS_COMPRA') { %>
        <div class="col-6 col-md-4 col-lg-3 app-item">
          <a href="/pedidosCompras?" class="app-card">
            <i class="fas fa-truck-loading app-icon"></i>
            <h3 class="app-title">Pedido de Compra</h3>
          </a>
        </div>
      <% } %>

      <!-- Orçamento OCR (ADMIN) -->
      <% if (user.role === 'ADMIN') { %>
        <div class="col-6 col-md-4 col-lg-3 app-item">
          <a href="/orcamento-ocr" class="app-card">
            <i class="fas fa-file-invoice app-icon"></i>
            <h3 class="app-title">Orçamento OCR</h3>
          </a>
        </div>
      <% } %>

      <!-- PDV System (NOVO) -->
      <div class="col-6 col-md-4 col-lg-3 app-item">
        <a href="/pdv/login" class="app-card">
          <i class="fas fa-cash-register app-icon"></i>
          <h3 class="app-title">Sistema PDV</h3>
        </a>
      </div>

    </div>
  </div>

  <!-- Scripts -->
  <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js" integrity="sha384-I7E8VVD/ismYTF4hNIPjVp/Zjvgyol6VFvRkX/vR+Vc4jQkC+hVqc2pM8ODewa9r" crossorigin="anonymous"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.min.js" integrity="sha384-fbbOQedDUMZZ5KreZpsbe1LCZPVmfTnH7ois6mU1QK+m14rQ1l2bGBq41eYeM/fS" crossorigin="anonymous"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  
  <script>
    // Logout confirmation
    document.getElementById('logoutBtn').addEventListener('click', function(e) {
      e.preventDefault();
      
      Swal.fire({
        title: 'Tem certeza?',
        text: "Você será desconectado do sistema.",
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#d33',
        cancelButtonColor: '#3085d6',
        confirmButtonText: 'Sim, sair!',
        cancelButtonText: 'Cancelar',
        background: '#fff',
        color: '#000'
      }).then((result) => {
        if (result.isConfirmed) {
          document.getElementById('logoutForm').submit();
        }
      });
    });

    // Search functionality
    document.getElementById('searchInput').addEventListener('keyup', function() {
      const query = this.value.toLowerCase();
      const apps = document.querySelectorAll('.app-item');
      
      apps.forEach(app => {
        const title = app.querySelector('.app-title').textContent.toLowerCase();
        if (title.includes(query)) {
          app.style.display = '';
        } else {
          app.style.display = 'none';
        }
      });
    });
  </script>
</body>
</html>
