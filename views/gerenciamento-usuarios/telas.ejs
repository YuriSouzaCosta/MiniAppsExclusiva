<!DOCTYPE html><html lang="pt-BR"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Permissões por Tela</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet"><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">  <link rel="stylesheet" href="/css/responsive-global.css">
</head><body class="bg-light"><main class="container py-4"><div class="d-flex justify-content-between align-items-center mb-4"><div><h1 class="h3 mb-1"><i class="fas fa-display me-2 text-primary"></i>Permissões por Tela</h1><p class="text-muted mb-0">Selecione quais roles podem acessar cada tela. Administradores sempre possuem acesso.</p></div><a href="/gerenciamento-usuarios" class="btn btn-outline-secondary">Voltar</a></div><% if (success) { %><div class="alert alert-success">Permissões salvas com sucesso.</div><% } %><% if (error) { %><div class="alert alert-danger">Não foi possível salvar as permissões.</div><% } %><div class="card shadow-sm"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead class="table-light"><tr><th>Tela</th><th>Roles com acesso</th><th></th></tr></thead><tbody><% screens.forEach(screen => { const selected = assignments[screen.key] || []; %><tr><td><strong><%= screen.label %></strong><br><small class="text-muted"><%= screen.prefix %></small></td><td><form id="screen-<%= screen.key %>" method="POST" action="/gerenciamento-usuarios/telas/<%= screen.key %>"><div class="d-flex flex-wrap gap-3"><% roles.forEach(role => { %><label class="form-check-label"><input class="form-check-input me-1" type="checkbox" name="roles" value="<%= role.value %>" <%= selected.includes(role.value) ? 'checked' : '' %>><%= role.label %> (<%= role.value %>)</label><% }) %></div></form></td><td><button form="screen-<%= screen.key %>" class="btn btn-primary btn-sm">Salvar</button></td></tr><% }) %></tbody></table></div></div></main></body></html>
