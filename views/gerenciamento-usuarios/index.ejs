<!DOCTYPE html>
<html lang="pt-BR"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Gerenciamento de Usuários</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet"><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"><style>body{background:#f8fafc;color:#1e293b}.page-header{background:#fff;border-bottom:1px solid #e2e8f0}.role-select{min-width:190px}.user-table td,.user-table th{vertical-align:middle}</style></head>
<body><header class="page-header py-3 mb-4"><div class="container d-flex align-items-center justify-content-between gap-3"><div><h1 class="h3 mb-1"><i class="fas fa-users-gear text-primary me-2"></i>Gerenciamento de Usuários</h1><p class="text-muted mb-0">Defina o perfil de acesso de cada usuário.</p></div><div class="d-flex gap-2"><a href="/gerenciamento-usuarios/telas" class="btn btn-primary"><i class="fas fa-display me-1"></i>Permissões por Tela</a><a href="/" class="btn btn-outline-secondary"><i class="fas fa-arrow-left me-1"></i>Voltar</a></div></div></header>
<main class="container pb-5"><% if (success) { %><div class="alert alert-success">Todos os perfis foram atualizados com sucesso.</div><% } %><% if (error) { %><div class="alert alert-danger">Não foi possível atualizar os perfis. Nenhuma alteração foi salva.</div><% } %><form id="roles-batch" action="/gerenciamento-usuarios/salvar-todos" method="POST"></form><div class="card shadow-sm border-0"><div class="card-body p-0"><div class="p-3 border-bottom d-flex justify-content-between align-items-center gap-3"><strong><%= users.length %> usuários</strong><div class="d-flex gap-2"><input id="search" class="form-control" style="max-width:320px" placeholder="Buscar usuário..."><button class="btn btn-primary text-nowrap" type="submit" form="roles-batch"><i class="fas fa-floppy-disk me-1"></i>Salvar todas as alterações</button></div></div><div class="table-responsive"><table class="table table-hover mb-0 user-table"><thead class="table-light"><tr><th>Usuário</th><th>Perfil</th></tr></thead><tbody id="users-table"><% users.forEach(targetUser => { %><tr data-name="<%= targetUser.NOMEUSU.toLowerCase() %>"><td><strong><%= targetUser.NOMEUSU %></strong></td><td><select class="form-select role-select" name="roles[<%= targetUser.CODUSU %>]" form="roles-batch" aria-label="Perfil de <%= targetUser.NOMEUSU %>"><option value="">Sem perfil</option><% roles.forEach(role => { %><option value="<%= role.value %>" <%= role.value === String(targetUser.AD_ROLE || '').trim() ? 'selected' : '' %>><%= role.label %> (<%= role.value %>)</option><% }) %></select></td></tr><% }) %></tbody></table></div><div class="p-3 border-top text-end"><button class="btn btn-primary" type="submit" form="roles-batch"><i class="fas fa-floppy-disk me-1"></i>Salvar todas as alterações</button></div></div></div></main><script>document.getElementById('search').addEventListener('input',event=>{const term=event.target.value.toLowerCase().trim();document.querySelectorAll('#users-table tr').forEach(row=>{row.hidden=!row.dataset.name.includes(term)})});</script></body></html>
