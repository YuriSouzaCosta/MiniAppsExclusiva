<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Transferências entre Lojas</title><link rel="stylesheet" href="/css/analise-transferencias-modern.css"><link rel="stylesheet" href="/css/transferencias-grupos.css"><link rel="stylesheet" href="/css/transferencias-header.css"><link rel="stylesheet" href="/css/transferencias-detalhes.css"><link rel="stylesheet" href="/css/responsive-global.css"><link rel="stylesheet" href="/css/report-loading.css"><script src="/js/report-loading.js"></script></head>
<body><header class="top"><img src="/images/logo.png" alt="Exclusiva"><div><span>RELATÓRIOS / ESTOQUE</span><h1>Transferências entre lojas</h1></div><a href="/">Central de Acessos</a></header>
<main><section class="filters" id="filters"><div class="date"><label>Data inicial</label><input type="date" id="dtIni"></div><div class="date"><label>Data final</label><input type="date" id="dtFin"></div><div id="filterSlots"></div><button class="primary" id="apply">Atualizar análise</button></section><div class="status" id="status">Carregando dados…</div>
<section class="kpis"><article><span>Valor movimentado</span><strong id="kValor">—</strong><small>pelo custo da mercadoria</small></article><article><span>Transferências</span><strong id="kTrans">—</strong><small>notas entre lojas</small></article><article><span>Itens movimentados</span><strong id="kItens">—</strong><small>unidades transferidas</small></article><article><span>Produtos únicos</span><strong id="kProdutos">—</strong><small>SKUs movimentados</small></article></section>
<section class="group-grid" id="groups"></section>
<section class="panel trend"><div class="panel-head"><div><span>EVOLUÇÃO</span><h2>Valor de custo movimentado por mês</h2></div><button class="ghost" id="csv">Exportar CSV</button></div><div id="trend"></div></section>
<section class="panel products"><div class="panel-head"><div><span>CONFERÊNCIA POR NOTA</span><h2>Detalhamento das transferências</h2></div><input type="search" id="detailSearch" placeholder="Buscar nota, empresa ou produto"></div><div class="table-wrap transfer-detail-wrap"><table class="transfer-detail-table"><thead><tr><th>Data</th><th>Nota / TOP</th><th>Origem</th><th>Destino</th><th>Produto</th><th>Qtd.</th><th>Custo unitário</th><th>Custo total</th></tr></thead><tbody id="transferDetails"></tbody></table></div></section>
<section class="panel products"><div class="panel-head"><div><span>CONSOLIDADO</span><h2>Produtos transferidos</h2></div><input type="search" id="search" placeholder="Buscar código, referência ou produto"></div><div class="table-wrap"><table><thead><tr><th>Produto</th><th>Origem</th><th>Destino</th><th>Itens</th><th>Valor de custo</th><th>Transferências</th></tr></thead><tbody id="items"></tbody></table></div></section></main><script src="/js/analise-transferencias-modern.js"></script></body></html>
