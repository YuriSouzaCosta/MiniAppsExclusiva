<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= pageTitle %> - Sistema PDV</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        'admin-primary': '#1e40af',
                        'sales-primary': '#15803d',
                    }
                }
            }
        }
    </script>
    <style>
        /* Custom scrollbar for premium feel */
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #f1f1f1; 
        }
        ::-webkit-scrollbar-thumb {
            background: #cbd5e1; 
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #94a3b8; 
        }
    </style>
</head>
<body class="bg-gray-50 min-h-screen font-sans text-gray-900">
    <div class="flex h-screen overflow-hidden">
        <!-- Sidebar -->
        <aside class="w-64 flex-shrink-0 transition-colors duration-300 bg-white border-r border-gray-200 flex flex-col">
            <div class="p-6">
                <h1 class="text-2xl font-bold tracking-tight text-gray-900">Sistema PDV</h1>
                <p class="text-xs font-semibold text-orange-600 mt-1 uppercase tracking-wider"><%= user.role === 'ADMIN' ? 'GERENTE' : 'Vendas' %></p>
            </div>

            <nav class="flex-1 px-4 space-y-2 overflow-y-auto">
                <% if (user.role === 'ADMIN') { %>
                    <a href="/pdv/manager" class="flex items-center gap-3 px-4 py-3 rounded-lg transition-colors <%= pageTitle === 'Dashboard Gerencial' ? 'bg-orange-50 text-orange-700' : 'text-gray-600 hover:bg-gray-50 hover:text-gray-900' %>">
                        <i data-lucide="layout-dashboard" class="w-5 h-5 <%= pageTitle === 'Dashboard Gerencial' ? 'text-orange-600' : 'text-gray-400 group-hover:text-gray-500' %>"></i>
                        <span class="font-medium">Dashboard Gerencial</span>
                    </a>
                    <div class="px-4 py-2 text-xs font-semibold text-gray-400 uppercase tracking-wider mt-4">Vendas</div>
                    <a href="/pdv/sales" class="flex items-center gap-3 px-4 py-3 rounded-lg transition-colors <%= pageTitle === 'Dashboard de Vendas' ? 'bg-orange-50 text-orange-700' : 'text-gray-600 hover:bg-gray-50 hover:text-gray-900' %>">
                        <i data-lucide="bar-chart-2" class="w-5 h-5 <%= pageTitle === 'Dashboard de Vendas' ? 'text-orange-600' : 'text-gray-400 group-hover:text-gray-500' %>"></i>
                        <span class="font-medium">Minhas Vendas</span>
                    </a>
                    <a href="/pdv/pos" class="flex items-center gap-3 px-4 py-3 rounded-lg transition-colors <%= pageTitle === 'Novo Pedido' ? 'bg-orange-50 text-orange-700' : 'text-gray-600 hover:bg-gray-50 hover:text-gray-900' %>">
                        <i data-lucide="shopping-cart" class="w-5 h-5 <%= pageTitle === 'Novo Pedido' ? 'text-orange-600' : 'text-gray-400 group-hover:text-gray-500' %>"></i>
                        <span class="font-medium">Novo Pedido</span>
                    </a>
                <% } else { %>
                    <a href="/pdv/sales" class="flex items-center gap-3 px-4 py-3 rounded-lg transition-colors <%= pageTitle === 'Dashboard de Vendas' ? 'bg-orange-50 text-orange-700' : 'text-gray-600 hover:bg-gray-50 hover:text-gray-900' %>">
                        <i data-lucide="layout-dashboard" class="w-5 h-5 <%= pageTitle === 'Dashboard de Vendas' ? 'text-orange-600' : 'text-gray-400 group-hover:text-gray-500' %>"></i>
                        <span class="font-medium">Dashboard</span>
                    </a>
                    <a href="/pdv/pos" class="flex items-center gap-3 px-4 py-3 rounded-lg transition-colors <%= pageTitle === 'Novo Pedido' ? 'bg-orange-50 text-orange-700' : 'text-gray-600 hover:bg-gray-50 hover:text-gray-900' %>">
                        <i data-lucide="shopping-cart" class="w-5 h-5 <%= pageTitle === 'Novo Pedido' ? 'text-orange-600' : 'text-gray-400 group-hover:text-gray-500' %>"></i>
                        <span class="font-medium">Novo Pedido</span>
                    </a>
                <% } %>
                
                <a href="/" class="flex items-center gap-3 px-4 py-3 rounded-lg text-gray-600 hover:bg-gray-50 hover:text-gray-900 transition-colors mt-8">
                    <i data-lucide="arrow-left" class="w-5 h-5 text-gray-400 group-hover:text-gray-500"></i>
                    <span class="font-medium">Voltar ao Menu</span>
                </a>
            </nav>

            <div class="p-4 border-t border-gray-200">
                <div class="flex items-center gap-3 px-4 py-3">
                    <div class="w-8 h-8 rounded-full bg-orange-100 flex items-center justify-center font-bold text-orange-700">
                        <%= user.username.charAt(0).toUpperCase() %>
                    </div>
                    <div class="flex-1 overflow-hidden">
                        <p class="text-sm font-medium text-gray-900 truncate"><%= user.username %></p>
                    </div>
                </div>
            </div>
        </aside>

        <!-- Main Content -->
        <main class="flex-1 overflow-y-auto bg-gray-50 p-8">
            <div class="max-w-7xl mx-auto">
