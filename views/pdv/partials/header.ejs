<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <meta name="theme-color" content="#ffffff">
    <title><%= pageTitle %> - Sistema PDV</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link rel="stylesheet" href="/css/pdv-mobile.css">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        'admin-primary': '#ea580c',
                        'sales-primary': '#15803d',
                    }
                }
            }
        }
    </script>
    <style>
        /* Custom scrollbar for premium feel */
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #f1f1f1; 
        }
        ::-webkit-scrollbar-thumb {
            background: #cbd5e1; 
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #94a3b8; 
        }
        /* Prevent pull-to-refresh on mobile */
        body {
            overscroll-behavior-y: contain;
        }
        /* Smooth scrolling */
        html {
            scroll-behavior: smooth;
        }
    </style>
  <link rel="stylesheet" href="/css/responsive-global.css">
</head>
<body class="bg-gray-50 min-h-screen font-sans text-gray-900 pb-20 md:pb-0 touch-scroll">
    <!-- Mobile Top Bar - Enhanced -->
    <header class="md:hidden sticky top-0 z-40 bg-white/95 backdrop-blur-sm border-b border-gray-200 px-4 py-3 flex items-center justify-between safe-area-inset-top">
        <div class="flex items-center gap-3">
            <div class="bg-gradient-to-br from-orange-100 to-orange-200 p-2 rounded-xl shadow-sm">
                <i data-lucide="shopping-bag" class="w-5 h-5 text-orange-600"></i>
            </div>
            <div>
                <h1 class="text-lg font-bold tracking-tight text-gray-900">Sistema PDV</h1>
                <p class="text-[10px] font-semibold text-orange-600 uppercase tracking-wider leading-none"><%= user.role === 'ADMIN' ? 'GERENTE' : 'VENDEDOR' %></p>
            </div>
        </div>
        <div class="flex items-center gap-3">
            <div class="text-right hidden min-[400px]:block">
                <p class="text-xs font-medium text-gray-600 truncate max-w-[100px]"><%= user.username %></p>
            </div>
            <div class="w-10 h-10 rounded-full bg-gradient-to-br from-orange-100 to-orange-200 flex items-center justify-center font-bold text-orange-700 text-sm shadow-sm">
                <%= user.username.charAt(0).toUpperCase() %>
            </div>
        </div>
    </header>

    <div class="flex h-screen overflow-hidden">
        <!-- Sidebar (Desktop only) -->
        <aside class="hidden md:flex w-64 flex-shrink-0 transition-colors duration-300 bg-white border-r border-gray-200 flex-col">
            <div class="p-6">
                <h1 class="text-2xl font-bold tracking-tight text-gray-900">Sistema PDV</h1>
                <p class="text-xs font-semibold text-orange-600 mt-1 uppercase tracking-wider"><%= user.role === 'ADMIN' ? 'GERENTE' : 'Vendas' %></p>
            </div>

            <nav class="flex-1 px-4 space-y-2 overflow-y-auto">
                <% if (user.role === 'ADMIN') { %>
                    <a href="/pdv/manager" class="flex items-center gap-3 px-4 py-3 rounded-lg transition-colors <%= pageTitle === 'Dashboard Gerencial' ? 'bg-orange-50 text-orange-700' : 'text-gray-600 hover:bg-gray-50 hover:text-gray-900' %>">
                        <i data-lucide="layout-dashboard" class="w-5 h-5 <%= pageTitle === 'Dashboard Gerencial' ? 'text-orange-600' : 'text-gray-400 group-hover:text-gray-500' %>"></i>
                        <span class="font-medium">Dashboard Gerencial</span>
                    </a>
                    <div class="px-4 py-2 text-xs font-semibold text-gray-400 uppercase tracking-wider mt-4">Vendas</div>
                    <a href="/pdv/sales" class="flex items-center gap-3 px-4 py-3 rounded-lg transition-colors <%= pageTitle === 'Dashboard de Vendas' ? 'bg-orange-50 text-orange-700' : 'text-gray-600 hover:bg-gray-50 hover:text-gray-900' %>">
                        <i data-lucide="bar-chart-2" class="w-5 h-5 <%= pageTitle === 'Dashboard de Vendas' ? 'text-orange-600' : 'text-gray-400 group-hover:text-gray-500' %>"></i>
                        <span class="font-medium">Minhas Vendas</span>
                    </a>
                    <a href="/pdv/my-orders" class="flex items-center gap-3 px-4 py-3 rounded-lg transition-colors <%= pageTitle === 'Meus Pedidos' ? 'bg-orange-50 text-orange-700' : 'text-gray-600 hover:bg-gray-50 hover:text-gray-900' %>">
                        <i data-lucide="list" class="w-5 h-5 <%= pageTitle === 'Meus Pedidos' ? 'text-orange-600' : 'text-gray-400 group-hover:text-gray-500' %>"></i>
                        <span class="font-medium">Meus Pedidos</span>
                    </a>
                    <a href="/pdv/pos" class="flex items-center gap-3 px-4 py-3 rounded-lg transition-colors <%= pageTitle === 'Novo Pedido' ? 'bg-orange-50 text-orange-700' : 'text-gray-600 hover:bg-gray-50 hover:text-gray-900' %>">
                        <i data-lucide="shopping-cart" class="w-5 h-5 <%= pageTitle === 'Novo Pedido' ? 'text-orange-600' : 'text-gray-400 group-hover:text-gray-500' %>"></i>
                        <span class="font-medium">Novo Pedido</span>
                    </a>
                <% } else { %>
                    <a href="/pdv/sales" class="flex items-center gap-3 px-4 py-3 rounded-lg transition-colors <%= pageTitle === 'Dashboard de Vendas' ? 'bg-orange-50 text-orange-700' : 'text-gray-600 hover:bg-gray-50 hover:text-gray-900' %>">
                        <i data-lucide="layout-dashboard" class="w-5 h-5 <%= pageTitle === 'Dashboard de Vendas' ? 'text-orange-600' : 'text-gray-400 group-hover:text-gray-500' %>"></i>
                        <span class="font-medium">Dashboard</span>
                    </a>
                    <a href="/pdv/my-orders" class="flex items-center gap-3 px-4 py-3 rounded-lg transition-colors <%= pageTitle === 'Meus Pedidos' ? 'bg-orange-50 text-orange-700' : 'text-gray-600 hover:bg-gray-50 hover:text-gray-900' %>">
                        <i data-lucide="list" class="w-5 h-5 <%= pageTitle === 'Meus Pedidos' ? 'text-orange-600' : 'text-gray-400 group-hover:text-gray-500' %>"></i>
                        <span class="font-medium">Meus Pedidos</span>
                    </a>
                    <a href="/pdv/pos" class="flex items-center gap-3 px-4 py-3 rounded-lg transition-colors <%= pageTitle === 'Novo Pedido' ? 'bg-orange-50 text-orange-700' : 'text-gray-600 hover:bg-gray-50 hover:text-gray-900' %>">
                        <i data-lucide="shopping-cart" class="w-5 h-5 <%= pageTitle === 'Novo Pedido' ? 'text-orange-600' : 'text-gray-400 group-hover:text-gray-500' %>"></i>
                        <span class="font-medium">Novo Pedido</span>
                    </a>
                <% } %>
                
                <a href="/" class="flex items-center gap-3 px-4 py-3 rounded-lg text-gray-600 hover:bg-gray-50 hover:text-gray-900 transition-colors mt-8">
                    <i data-lucide="arrow-left" class="w-5 h-5 text-gray-400 group-hover:text-gray-500"></i>
                    <span class="font-medium">Central de Acessos</span>
                </a>
            </nav>

            <div class="p-4 border-t border-gray-200">
                <div class="flex items-center gap-3 px-4 py-3">
                    <div class="w-8 h-8 rounded-full bg-orange-100 flex items-center justify-center font-bold text-orange-700">
                        <%= user.username.charAt(0).toUpperCase() %>
                    </div>
                    <div class="flex-1 overflow-hidden">
                        <p class="text-sm font-medium text-gray-900 truncate"><%= user.username %></p>
                    </div>
                </div>
            </div>
        </aside>

        <!-- Mobile Bottom Navigation - Enhanced -->
        <nav class="md:hidden fixed bottom-0 left-0 right-0 z-50 bg-white/95 backdrop-blur-sm border-t border-gray-200 pdv-bottom-nav shadow-[0_-4px_20px_rgba(0,0,0,0.08)]">
            <div class="flex items-center justify-around px-2">
                <% if (user.role === 'ADMIN') { %>
                    <a href="/pdv/manager" class="touch-active flex flex-col items-center gap-1 py-3 px-4 rounded-xl min-w-[64px] <%= pageTitle === 'Dashboard Gerencial' ? 'text-orange-600 bg-orange-50' : 'text-gray-400' %>">
                        <i data-lucide="layout-dashboard" class="w-6 h-6"></i>
                        <span class="text-[10px] font-semibold">Gerencial</span>
                    </a>
                <% } %>
                <a href="/pdv/sales" class="touch-active flex flex-col items-center gap-1 py-3 px-4 rounded-xl min-w-[64px] <%= pageTitle === 'Dashboard de Vendas' ? 'text-orange-600 bg-orange-50' : 'text-gray-400' %>">
                    <i data-lucide="bar-chart-2" class="w-6 h-6"></i>
                    <span class="text-[10px] font-semibold">Vendas</span>
                </a>
                <a href="/pdv/my-orders" class="touch-active flex flex-col items-center gap-1 py-3 px-4 rounded-xl min-w-[64px] <%= pageTitle === 'Meus Pedidos' ? 'text-orange-600 bg-orange-50' : 'text-gray-400' %>">
                    <i data-lucide="list" class="w-6 h-6"></i>
                    <span class="text-[10px] font-semibold">Pedidos</span>
                </a>
                <a href="/pdv/pos" class="touch-active pdv-fab-button flex flex-col items-center gap-1 min-w-[72px]">
                    <div class="<%= pageTitle === 'Novo Pedido' ? 'bg-green-600' : 'bg-orange-600' %> text-white p-3 rounded-2xl shadow-lg border-4 border-gray-50">
                        <i data-lucide="plus" class="w-7 h-7"></i>
                    </div>
                    <span class="text-[10px] font-semibold <%= pageTitle === 'Novo Pedido' ? 'text-green-600' : 'text-gray-500' %>">Novo</span>
                </a>
                <a href="/" class="touch-active flex flex-col items-center gap-1 py-3 px-4 rounded-xl min-w-[64px] text-gray-400">
                    <i data-lucide="home" class="w-6 h-6"></i>
                    <span class="text-[10px] font-semibold">Menu</span>
                </a>
            </div>
        </nav>


        <!-- Main Content -->
        <main class="flex-1 overflow-y-auto bg-gray-50 p-4 md:p-8">
            <div class="max-w-7xl mx-auto">
