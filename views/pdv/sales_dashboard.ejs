<%- include('partials/header', { pageTitle: 'Dashboard de Vendas' }) %>

<div class="space-y-4 md:space-y-6 pb-24 md:pb-4">
    <% if (typeof viewingSeller !== 'undefined' && viewingSeller) { %>
        <div class="bg-blue-50 border-l-4 border-blue-500 p-4 rounded-r shadow-sm">
            <div class="flex">
                <div class="flex-shrink-0">
                    <i data-lucide="eye" class="h-5 w-5 text-blue-400"></i>
                </div>
                <div class="ml-3">
                    <p class="text-sm text-blue-700">
                        Você está visualizando o perfil de: <span class="font-bold"><%= viewingSeller %></span>
                    </p>
                </div>
            </div>
        </div>
    <% } %>

    <!-- Header with Date Filter -->
    <div class="flex flex-col gap-4">
        <h2 class="text-2xl md:text-3xl font-bold text-gray-900">Olá, <%= typeof viewingSeller !== 'undefined' && viewingSeller ? viewingSeller : user.username %></h2>
        
        <!-- Date Filter - Mobile Optimized -->
        <form action="/pdv/sales" method="GET" class="flex flex-col sm:flex-row items-stretch sm:items-end gap-3">
            <% if (typeof viewingSeller !== 'undefined' && viewingSeller) { %>
                <input type="hidden" name="sellerId" value="<%= viewingSeller.replace('Vendedor ', '') %>">
            <% } %>
            <div class="flex flex-1 gap-3">
                <div class="flex-1">
                    <label for="startDate" class="block text-xs font-semibold text-gray-500 mb-1">Data Inicial</label>
                    <input type="date" 
                           id="startDate"
                           name="startDate" 
                           value="<%= typeof startDate !== 'undefined' ? startDate : '' %>"
                           class="h-12 w-full px-4 border-2 border-gray-200 rounded-xl focus:ring-2 focus:ring-green-500 focus:border-green-500 text-base transition-all"
                           required>
                </div>
                <div class="flex-1">
                    <label for="endDate" class="block text-xs font-semibold text-gray-500 mb-1">Data Final</label>
                    <input type="date" 
                           id="endDate"
                           name="endDate" 
                           value="<%= typeof endDate !== 'undefined' ? endDate : '' %>"
                           class="h-12 w-full px-4 border-2 border-gray-200 rounded-xl focus:ring-2 focus:ring-green-500 focus:border-green-500 text-base transition-all"
                           required>
                </div>
            </div>
            <div class="flex gap-2">
                <button type="submit" class="touch-active flex-1 sm:flex-none inline-flex items-center justify-center h-12 px-6 border border-transparent text-sm font-semibold rounded-xl shadow-sm text-white bg-gradient-to-r from-green-600 to-green-700 transition-all">
                    <i data-lucide="filter" class="w-4 h-4 mr-2"></i>
                    Filtrar
                </button>
                <% if ((typeof startDate !== 'undefined' && startDate) || (typeof endDate !== 'undefined' && endDate)) { %>
                    <a href="/pdv/sales<%= typeof viewingSeller !== 'undefined' && viewingSeller ? '?sellerId=' + viewingSeller.replace('Vendedor ', '') : '' %>" class="touch-active flex-1 sm:flex-none inline-flex items-center justify-center h-12 px-4 border-2 border-gray-200 shadow-sm text-sm font-semibold rounded-xl text-gray-700 bg-white transition-all">
                        Limpar
                    </a>
                <% } %>
            </div>
        </form>
    </div>
    
    <!-- Metrics Cards - Horizontal Scroll on Mobile -->
    <div class="-mx-4 px-4 md:mx-0 md:px-0">
        <div class="flex md:grid md:grid-cols-2 lg:grid-cols-4 gap-4 overflow-x-auto hide-scrollbar pb-2 md:pb-0 snap-x snap-mandatory">
            <div class="min-w-[75%] sm:min-w-[45%] md:min-w-0 snap-start rounded-xl border-2 border-green-200 bg-gradient-to-br from-green-50 to-emerald-50 text-gray-950 shadow-sm">
                <div class="flex flex-row items-center justify-between pb-2 p-4 md:p-6">
                    <h3 class="tracking-tight text-sm font-semibold text-green-900">Vendas Hoje</h3>
                    <div class="bg-green-100 p-2 rounded-xl">
                        <i data-lucide="dollar-sign" class="h-5 w-5 text-green-600"></i>
                    </div>
                </div>
                <div class="p-4 md:p-6 pt-0">
                    <div class="text-2xl md:text-3xl font-bold text-green-700">R$ <%= metrics.dailySales.toLocaleString('pt-BR', { minimumFractionDigits: 2 }) %></div>
                    <p class="text-xs text-green-600">Hoje</p>
                </div>
            </div>

            <div class="min-w-[75%] sm:min-w-[45%] md:min-w-0 snap-start rounded-xl border-2 border-gray-200 bg-white text-gray-950 shadow-sm">
                <div class="flex flex-row items-center justify-between pb-2 p-4 md:p-6">
                    <h3 class="tracking-tight text-sm font-semibold">Total de Vendas</h3>
                    <div class="bg-gray-100 p-2 rounded-xl">
                        <i data-lucide="calendar" class="h-5 w-5 text-gray-500"></i>
                    </div>
                </div>
                <div class="p-4 md:p-6 pt-0">
                    <div class="text-2xl md:text-3xl font-bold">R$ <%= metrics.totalSales.toLocaleString('pt-BR', { minimumFractionDigits: 2 }) %></div>
                    <p class="text-xs text-gray-500">No período selecionado</p>
                </div>
            </div>

            <div class="min-w-[75%] sm:min-w-[45%] md:min-w-0 snap-start rounded-xl border-2 border-gray-200 bg-white text-gray-950 shadow-sm">
                <div class="flex flex-row items-center justify-between pb-2 p-4 md:p-6">
                    <h3 class="tracking-tight text-sm font-semibold">Meta Diária</h3>
                    <div class="bg-gray-100 p-2 rounded-xl">
                        <i data-lucide="target" class="h-5 w-5 text-gray-500"></i>
                    </div>
                </div>
                <div class="p-4 md:p-6 pt-0">
                    <div class="text-2xl md:text-3xl font-bold"><%= metrics.dailyGoalProgress %>%</div>
                    <div class="w-full bg-gray-200 rounded-full h-2.5 mt-2">
                        <div class="bg-green-600 h-2.5 rounded-full transition-all" style="width: <%= metrics.dailyGoalProgress %>%"></div>
                    </div>
                    <p class="text-xs text-gray-500 mt-1">Meta: R$ <%= metrics.dailyGoal.toLocaleString('pt-BR') %></p>
                </div>
            </div>

            <div class="min-w-[75%] sm:min-w-[45%] md:min-w-0 snap-start rounded-xl border-2 border-gray-200 bg-white text-gray-950 shadow-sm">
                <div class="flex flex-row items-center justify-between pb-2 p-4 md:p-6">
                    <h3 class="tracking-tight text-sm font-semibold">Meta Total</h3>
                    <div class="bg-gray-100 p-2 rounded-xl">
                        <i data-lucide="flag" class="h-5 w-5 text-gray-500"></i>
                    </div>
                </div>
                <div class="p-4 md:p-6 pt-0">
                    <div class="text-2xl md:text-3xl font-bold"><%= metrics.totalGoalProgress %>%</div>
                    <div class="w-full bg-gray-200 rounded-full h-2.5 mt-2">
                        <div class="bg-blue-600 h-2.5 rounded-full transition-all" style="width: <%= metrics.totalGoalProgress %>%"></div>
                    </div>
                    <p class="text-xs text-gray-500 mt-1">Meta: R$ <%= metrics.totalGoal.toLocaleString('pt-BR') %></p>
                </div>
            </div>
        </div>
    </div>

    <!-- Sales List -->
    <div class="rounded-xl border-2 border-gray-200 bg-white text-gray-950 shadow-sm overflow-hidden">
        <div class="flex items-center justify-between p-4 md:p-6 border-b border-gray-100">
            <h3 class="font-semibold leading-none tracking-tight flex items-center gap-2">
                <i data-lucide="list" class="w-4 h-4 text-gray-400"></i>
                Vendas do Dia
            </h3>
        </div>
        <div class="divide-y divide-gray-100">
            <% if (recentSales && recentSales.length > 0) { %>
                <% recentSales.forEach(sale => { %>
                    <div class="touch-active flex items-center justify-between p-4 md:p-6 transition-colors">
                        <div class="flex-1 min-w-0 pr-4">
                            <% if (sale.ADPEDIDO) { %>
                                <p class="font-semibold text-gray-900 truncate">Nota: <%= sale.NUNOTA %> | Pedido: #<%= sale.ADPEDIDO %></p>
                            <% } else { %>
                                <p class="font-semibold text-gray-900 truncate">Pedido: #<%= sale.NUNOTA %></p>
                            <% } %>
                            <p class="text-sm text-gray-500 truncate"><%= sale.RAZAOSOCIAL %></p>
                        </div>
                        <div class="text-right flex-shrink-0">
                            <p class="font-bold text-lg text-gray-900">R$ <%= (sale.VLRNOTA || 0).toLocaleString('pt-BR', { minimumFractionDigits: 2 }) %></p>
                            <% if (sale.ADPEDIDO) { %>
                                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold bg-green-100 text-green-700">
                                    Concluído
                                </span>
                            <% } else { %>
                                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold bg-amber-100 text-amber-700">
                                    Em Aberto
                                </span>
                            <% } %>
                        </div>
                    </div>
                <% }); %>
            <% } else { %>
                <div class="flex flex-col items-center justify-center py-12 text-gray-400">
                    <i data-lucide="inbox" class="w-12 h-12 mb-3 opacity-50"></i>
                    <p class="text-sm">Nenhuma venda realizada hoje.</p>
                </div>
            <% } %>
        </div>
    </div>
</div>
<%- include('partials/footer') %>
