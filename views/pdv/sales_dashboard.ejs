<%- include('partials/header', { pageTitle: 'Dashboard de Vendas' }) %>

<div class="space-y-6">
    <% if (typeof viewingSeller !== 'undefined' && viewingSeller) { %>
        <div class="bg-blue-50 border-l-4 border-blue-500 p-4 rounded-r shadow-sm">
            <div class="flex">
                <div class="flex-shrink-0">
                    <i data-lucide="eye" class="h-5 w-5 text-blue-400"></i>
                </div>
                <div class="ml-3">
                    <p class="text-sm text-blue-700">
                        Você está visualizando o perfil de: <span class="font-bold"><%= viewingSeller %></span>
                    </p>
                </div>
            </div>
        </div>
    <% } %>

    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <h2 class="text-3xl font-bold text-gray-900">Olá, <%= typeof viewingSeller !== 'undefined' && viewingSeller ? viewingSeller : user.username %></h2>
        
        <form action="/pdv/sales" method="GET" class="flex flex-col sm:flex-row items-end sm:items-center gap-2">
            <% if (typeof viewingSeller !== 'undefined' && viewingSeller) { %>
                <input type="hidden" name="sellerId" value="<%= viewingSeller.replace('Vendedor ', '') %>">
            <% } %>
            <div class="flex items-center gap-2">
                <div class="relative">
                    <label for="startDate" class="block text-xs font-medium text-gray-500 mb-1">Data Inicial</label>
                    <input type="date" 
                           id="startDate"
                           name="startDate" 
                           value="<%= typeof startDate !== 'undefined' ? startDate : '' %>"
                           class="pl-3 pr-3 py-2 border border-gray-300 rounded-lg focus:ring-green-500 focus:border-green-500 block w-full sm:text-sm"
                           required>
                </div>
                <div class="relative">
                    <label for="endDate" class="block text-xs font-medium text-gray-500 mb-1">Data Final</label>
                    <input type="date" 
                           id="endDate"
                           name="endDate" 
                           value="<%= typeof endDate !== 'undefined' ? endDate : '' %>"
                           class="pl-3 pr-3 py-2 border border-gray-300 rounded-lg focus:ring-green-500 focus:border-green-500 block w-full sm:text-sm"
                           required>
                </div>
            </div>
            <button type="submit" class="mb-[1px] inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-lg shadow-sm text-white bg-green-600 hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500">
                <i data-lucide="filter" class="w-4 h-4 mr-2"></i>
                Filtrar
            </button>
            <% if ((typeof startDate !== 'undefined' && startDate) || (typeof endDate !== 'undefined' && endDate)) { %>
                <a href="/pdv/sales<%= typeof viewingSeller !== 'undefined' && viewingSeller ? '?sellerId=' + viewingSeller.replace('Vendedor ', '') : '' %>" class="mb-[1px] inline-flex items-center px-3 py-2 border border-gray-300 shadow-sm text-sm leading-4 font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500">
                    Limpar
                </a>
            <% } %>
        </form>
    </div>
    
    <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-4">
        <div class="rounded-xl border border-green-100 bg-green-50 text-gray-950 shadow-sm">
            <div class="flex flex-row items-center justify-between space-y-0 pb-2 p-6">
                <h3 class="tracking-tight text-sm font-medium text-green-900">Vendas Hoje</h3>
                <i data-lucide="dollar-sign" class="h-4 w-4 text-green-600"></i>
            </div>
            <div class="p-6 pt-0">
                <div class="text-2xl font-bold text-green-700">R$ <%= metrics.dailySales.toLocaleString('pt-BR', { minimumFractionDigits: 2 }) %></div>
                <p class="text-xs text-green-600">Hoje</p>
            </div>
        </div>

        <div class="rounded-xl border border-gray-200 bg-white text-gray-950 shadow-sm">
            <div class="flex flex-row items-center justify-between space-y-0 pb-2 p-6">
                <h3 class="tracking-tight text-sm font-medium">Total de Vendas</h3>
                <i data-lucide="calendar" class="h-4 w-4 text-gray-500"></i>
            </div>
            <div class="p-6 pt-0">
                <div class="text-2xl font-bold">R$ <%= metrics.totalSales.toLocaleString('pt-BR', { minimumFractionDigits: 2 }) %></div>
                <p class="text-xs text-gray-500">No período selecionado</p>
            </div>
        </div>

        <div class="rounded-xl border border-gray-200 bg-white text-gray-950 shadow-sm">
            <div class="flex flex-row items-center justify-between space-y-0 pb-2 p-6">
                <h3 class="tracking-tight text-sm font-medium">Meta Diária</h3>
                <i data-lucide="target" class="h-4 w-4 text-gray-500"></i>
            </div>
            <div class="p-6 pt-0">
                <div class="text-2xl font-bold"><%= metrics.dailyGoalProgress %>%</div>
                <div class="w-full bg-gray-200 rounded-full h-2.5 mt-2">
                    <div class="bg-green-600 h-2.5 rounded-full" style="width: <%= metrics.dailyGoalProgress %>%"></div>
                </div>
                <p class="text-xs text-gray-500 mt-1">Meta: R$ <%= metrics.dailyGoal.toLocaleString('pt-BR') %></p>
            </div>
        </div>

        <div class="rounded-xl border border-gray-200 bg-white text-gray-950 shadow-sm">
            <div class="flex flex-row items-center justify-between space-y-0 pb-2 p-6">
                <h3 class="tracking-tight text-sm font-medium">Meta Total</h3>
                <i data-lucide="flag" class="h-4 w-4 text-gray-500"></i>
            </div>
            <div class="p-6 pt-0">
                <div class="text-2xl font-bold"><%= metrics.totalGoalProgress %>%</div>
                <div class="w-full bg-gray-200 rounded-full h-2.5 mt-2">
                    <div class="bg-blue-600 h-2.5 rounded-full" style="width: <%= metrics.totalGoalProgress %>%"></div>
                </div>
                <p class="text-xs text-gray-500 mt-1">Meta: R$ <%= metrics.totalGoal.toLocaleString('pt-BR') %></p>
            </div>
        </div>
    </div>

    <div class="rounded-xl border border-gray-200 bg-white text-gray-950 shadow-sm">
        <div class="flex flex-col space-y-1.5 p-6">
            <h3 class="font-semibold leading-none tracking-tight">Vendas do Dia</h3>
        </div>
        <div class="p-6 pt-0">
            <div class="space-y-4">
                <% if (recentSales && recentSales.length > 0) { %>
                    <% recentSales.forEach(sale => { %>
                        <div class="flex items-center justify-between border-b pb-4 last:border-0 last:pb-0">
                            <div>
                                <% if (sale.ADPEDIDO) { %>
                                    <p class="font-medium">Nota: <%= sale.NUNOTA %> | Pedido: #<%= sale.ADPEDIDO %></p>
                                <% } else { %>
                                    <p class="font-medium">Pedido: #<%= sale.NUNOTA %></p>
                                <% } %>
                                <p class="text-sm text-gray-500"><%= sale.RAZAOSOCIAL %></p>
                            </div>
                            <div class="text-right">
                                <p class="font-medium">R$ <%= (sale.VLRNOTA || 0).toLocaleString('pt-BR', { minimumFractionDigits: 2 }) %></p>
                                <% if (sale.ADPEDIDO) { %>
                                    <p class="text-xs text-green-600 font-semibold">Concluído</p>
                                <% } else { %>
                                    <p class="text-xs text-amber-600 font-semibold">Em Aberto</p>
                                <% } %>
                            </div>
                        </div>
                    <% }); %>
                <% } else { %>
                    <p class="text-sm text-gray-500 text-center py-4">Nenhuma venda realizada hoje.</p>
                <% } %>
            </div>
        </div>
    </div>
</div>
<%- include('partials/footer') %>
