<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Fila de Separação</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap">
    <link rel="stylesheet" href="/css/requisicoes.css" />
</head>

<body class="req-body">
    <div class="req-header">
        <a href="/" class="btn btn-light border"><i class="bi bi-arrow-left"></i></a>
        <div class="me-auto">
            <h1>Fila de Separação</h1>
            <p class="req-sub">Requisições de todas as lojas — clique para separar</p>
        </div>
        <button class="btn btn-outline-dark" id="btnAtualizar">
            <i class="bi bi-arrow-clockwise"></i> Atualizar
        </button>
        <a href="/requisicoes" class="btn btn-light border">Todas as requisições</a>
    </div>

    <div class="req-conteudo">
        <div class="req-abas" id="abas">
            <button class="req-aba ativa" data-status="ABERTA">Abertas <span class="contador">0</span></button>
            <button class="req-aba" data-status="EM_SEPARACAO">Em andamento <span class="contador">0</span></button>
            <button class="req-aba" data-status="FINALIZADA">Finalizadas <span class="contador">0</span></button>
            <button class="req-aba" data-status="RECEBIDA">Recebidas <span class="contador">0</span></button>
        </div>

        <div class="req-grade" id="lista"></div>
        <div class="req-vazio d-none" id="vazio">
            <i class="bi bi-check2-circle"></i>
            Nada nesta fila no momento.
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/js/requisicoes/lista.js"></script>
    <script>
        iniciarLista({ escopo: 'fila', statusInicial: 'ABERTA' });
        document.getElementById('btnAtualizar').addEventListener('click', () => carregarLista());
    </script>
</body>

</html>
