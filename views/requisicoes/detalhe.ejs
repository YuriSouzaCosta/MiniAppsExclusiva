<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>Requisição #<%= numReq %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap">
    <link rel="stylesheet" href="/css/requisicoes.css" />
</head>

<body class="req-body">
    <div class="req-header">
        <a href="javascript:history.back()" class="btn btn-light border"><i class="bi bi-arrow-left"></i></a>
        <div class="req-titulo">
            <h1>Requisição #<%= numReq %></h1>
            <p class="req-sub" id="subtitulo">Carregando...</p>
        </div>
        <span class="req-etiqueta et-normal" id="etiquetaStatus">-</span>
    </div>

    <div class="req-conteudo">
        <div class="row g-3 mb-3" id="cabecalho"></div>
        <div id="listaItens"></div>
    </div>

    <div class="req-barra" id="barraAcoes" style="display:none">
        <div class="req-barra-info" id="resumoSeparacao">-</div>
        <div class="req-barra-botoes" id="botoesAcao"></div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        const NUM_REQ = <%= numReq %>;
        const USUARIO = '<%= user.username %>';
        const PODE_SEPARAR = <%= podeSeparar %>;
    </script>
    <script src="/js/requisicoes/detalhe.js"></script>
</body>

</html>
