<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>Nova Requisição</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap">
    <link rel="stylesheet" href="/css/requisicoes.css" />
</head>

<body class="req-body">
    <div class="req-header">
        <a href="/requisicoes" class="btn btn-light border"><i class="bi bi-arrow-left"></i></a>
        <div class="req-titulo">
            <h1>Nova Requisição</h1>
            <p class="req-sub">Descrição, código de barras, referência ou código Sankhya</p>
        </div>
    </div>

    <div class="req-conteudo">
        <div class="row g-3 mb-3">
            <div class="col-6 col-md-3">
                <label class="form-label fw-semibold">Grupo requisitado</label>
                <select class="form-select form-select-lg" id="grupo">
                    <% grupos.forEach(function (g) { %>
                        <option value="<%= g %>"><%= g %></option>
                    <% }) %>
                </select>
                <div class="form-text">De onde a mercadoria vai sair</div>
            </div>
            <div class="col-6 col-md-3">
                <label class="form-label fw-semibold">Empresa de destino</label>
                <select class="form-select form-select-lg" id="codempDestino">
                    <% empresas.forEach(function (e) { %>
                        <option value="<%= e.CODEMP %>" <%= codempSugerido === e.CODEMP ? 'selected' : '' %>>
                            <%= e.CODEMP %> - <%= e.NOMEFANTASIA %>
                        </option>
                    <% }) %>
                </select>
                <div class="form-text">Quem vai receber</div>
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label fw-semibold">Prioridade</label>
                <select class="form-select form-select-lg" id="prioridade">
                    <option value="NORMAL">Normal</option>
                    <option value="URGENTE">Urgente</option>
                </select>
            </div>
            <div class="col-6 col-md-4">
                <label class="form-label fw-semibold">Observação</label>
                <input type="text" class="form-control form-control-lg" id="observacao"
                    placeholder="Opcional" maxlength="500">
            </div>
        </div>

        <div class="req-busca mb-4">
            <input type="text" id="busca" autocomplete="off" autofocus
                placeholder="Bipe o código de barras ou digite a descrição / referência / código Sankhya...">
            <div class="req-resultados d-none" id="resultados"></div>
        </div>

        <table class="req-tabela">
            <thead>
                <tr>
                    <th>Produto</th>
                    <th style="width:90px">Código</th>
                    <th style="width:140px">Referência</th>
                    <th style="width:120px">Saldo grupo</th>
                    <th style="width:120px">Quantidade</th>
                    <th style="width:60px"></th>
                </tr>
            </thead>
            <tbody id="corpoLista">
                <tr id="linhaVazia">
                    <td colspan="6" class="req-td-vazio text-center text-muted py-4">
                        Nenhum produto na lista. Use a busca acima.
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    <div class="req-barra">
        <div class="req-barra-info">
            <strong id="totalItens">0</strong> produto(s) na lista
        </div>
        <div class="req-barra-botoes">
            <a href="/requisicoes" class="btn btn-light border d-flex align-items-center justify-content-center">
                Cancelar
            </a>
            <button class="req-btn-principal" id="btnEnviar" disabled>
                <i class="bi bi-send"></i> Enviar
            </button>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/js/requisicoes/nova.js"></script>
</body>

</html>
